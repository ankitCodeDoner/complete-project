# Copy to server/.env and fill in. server/.env is git-ignored.

# Port for the admin API (admin .env -> VITE_BASE_URL=http://localhost:5000/api/)
PORT=5000

# Admin sign-in for the panel
ADMIN_NAME=MedVance Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Long random string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string

# Restrict which origin may call the API (default "*")
# CORS_ORIGIN=http://localhost:5173

# Website folders this API manages (relative to this server/ folder)
SITE_DATA_DIR=../../surgical/src/data
SITE_PUBLIC_DIR=../../surgical/public
